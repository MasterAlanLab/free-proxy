#!/sbin/openrc-run

name="Free Proxy"
description="Free Proxy exit pool and local proxy gateway"
directory="/opt/free-proxy"
command="/opt/free-proxy/.venv/bin/free-proxy"
command_args="serve"
command_background="yes"
pidfile="/run/free-proxy.pid"
output_log="/var/log/free-proxy.log"
error_log="/var/log/free-proxy.log"
env_file="/etc/free-proxy/free-proxy.env"

depend() {
    need net
    after firewall
}

start_pre() {
    set -a
    . "$env_file"
    set +a
    "$command" database-upgrade
    "$command" preflight
}
