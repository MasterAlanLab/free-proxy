[Unit]
Description=Free Proxy exit pool and local proxy gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/free-proxy
EnvironmentFile=/etc/free-proxy/free-proxy.env
ExecStartPre=/opt/free-proxy/.venv/bin/free-proxy database-upgrade
ExecStartPre=/opt/free-proxy/.venv/bin/free-proxy preflight
ExecStart=/opt/free-proxy/.venv/bin/free-proxy serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=mixed
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
